# Optional: overrides the default https://crayoratech.com (canonical URLs, sitemap, Open Graph).
# Only needed for staging or preview deployments.
# NEXT_PUBLIC_SITE_URL=https://staging.crayoratech.com

# Contact form delivery via Resend (https://resend.com). Use a send-only API key.
RESEND_API_KEY=
# Sender on a domain verified in Resend. Without it, resend.dev only delivers to the account owner.
RESEND_FROM=Crayora <hello@crayoratech.com>
# Inboxes that receive project enquiries (comma separated)
CONTACT_TO=sahoojyotiranjan595@gmail.com,crayoratech@gmail.com
